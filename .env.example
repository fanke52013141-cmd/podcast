# === 写稿 LLM ===
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 备用（主 API 失败自动切换）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# === TTS 服务（5080 机器）===
TTS_URL=http://127.0.0.1:8600
SOULX_MODEL_PATH=pretrained_models/SoulX-Podcast-1.7B
SEGMENT_MINUTES=7

# === VoiceStar 定长片段（可选，二选一）===
VOICESTAR_URL=
VOICESTAR_CMD=

# === 写稿约束 ===
# 副语言标签白名单（逗号分隔；可选 laughter,sigh,breathing,coughing,throat_clearing）
PARALING_TAGS=laughter,sigh,breathing,coughing,throat_clearing

# === 任务默认值 ===
DEFAULT_STYLE=幽默对谈
DEFAULT_MINUTES=10
DEFAULT_HOST_VOICE=v01_female_warm
DEFAULT_PARTNER_VOICE=v02_male_deep
DEFAULT_PROVIDER=mock

# === 音色库 ===
VOICE_LIB_DIR=voice_lib

# === 观测（可选）===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# === API 合成引擎（PLAN §1）===
# 引擎切换：soulx(默认) | indextts | minimax | doubao
TTS_ENGINE=soulx
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=speech-02-hd
DEFAULT_MINIMAX_VOICE=male-qn-qingse
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://openspeech.bytedance.com
DEFAULT_DOUBAO_SPEAKER=
